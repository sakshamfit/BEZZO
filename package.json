{
  "name": "bezzo",
  "version": "1.0.0",
  "private": true,
  "description": "BEZZO — B2B pharmaceutical marketplace (web, Android, iOS, operational dashboards)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@bezzo/web",
    "dev": "npm run dev --workspace=@bezzo/web",
    "dev:api": "npm run dev --workspace=@bezzo/api",
    "dev:web": "npm run dev --workspace=@bezzo/web",
    "start": "npm run start --workspace=@bezzo/web",
    "typecheck": "npm run typecheck --workspace=@bezzo/web",
    "lint": "npm run lint --workspace=@bezzo/web",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml}\""
  },
  "overrides": {
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all",
    "arrowParens": "always"
  }
}
