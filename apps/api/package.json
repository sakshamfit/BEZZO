{
  "name": "@bezzo/api",
  "version": "1.0.0",
  "private": true,
  "description": "BEZZO API \u2014 modular NestJS backend for the B2B pharmaceutical marketplace",
  "main": "./dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand --testPathPattern=src/",
    "test:integration": "jest --config jest-integration.config.js --runInBand",
    "test:concurrency": "jest --config jest-integration.config.js --runInBand --testPathPattern=concurrency",
    "openapi:export": "node ./scripts/export-openapi.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bezzo/config": "workspace:*",
    "@bezzo/contracts": "workspace:*",
    "@bezzo/crypto": "workspace:*",
    "@bezzo/database": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/swagger": "^11.1.0",
    "@opensearch-project/opensearch": "^3.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
