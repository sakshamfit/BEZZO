# =============================================================================
# BEZZO — environment template
# Copy to `.env` and fill in real values. NEVER commit real credentials.
# =============================================================================

# --- runtime ----------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_PATH=/api/v1
API_PUBLIC_URL=http://localhost:4000

# --- database (PostgreSQL is the transactional source of truth) --------------
DATABASE_URL=postgresql://bezzo:bezzo@localhost:5432/bezzo_local
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# --- redis (cache / geo / offers). Loss must never corrupt PostgreSQL state --
REDIS_URL=redis://localhost:6379
REDIS_REQUIRED=false

# --- search (OpenSearch is derived, never authoritative) ---------------------
SEARCH_ENABLED=false
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_PRODUCT_INDEX=bezzo-products-v1

# --- object storage (S3 compatible) -----------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=bezzo-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_SIGNED_URL_TTL_SECONDS=300

# --- authentication ---------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_PEPPER=change-me-otp-pepper
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_DEV_ECHO=false
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_SECONDS=900

# --- rate limiting ----------------------------------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# --- payments (provider abstraction; no business logic is gateway-specific) --
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=

# --- logistics (provider abstraction) ---------------------------------------
LOGISTICS_PROVIDER=manual
PORTER_API_KEY=
PORTER_API_SECRET=
PORTER_BASE_URL=https://api.porter.in
PORTER_WEBHOOK_SECRET=

# --- notifications ----------------------------------------------------------
NOTIFICATIONS_PUSH_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_WHATSAPP_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER_API_KEY=
EMAIL_SMTP_URL=
WHATSAPP_API_TOKEN=

# --- picker / assignment engine ---------------------------------------------
PICKER_OFFER_TIMEOUT_SECONDS=20
PICKER_ASSIGNMENT_RADIUS_KM=12
PICKER_HEARTBEAT_STALE_SECONDS=120
PICKER_DEFAULT_CAPACITY_PACKAGES=20
PICKER_GEOFENCE_RADIUS_METERS=250
PICKER_ALLOW_PARALLEL_OFFERS=false
PICKER_PARALLEL_OFFER_COUNT=3

# --- business defaults (configurable, never hard-coded) ----------------------
BUSINESS_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
RESERVATION_TTL_SECONDS=900
MARKETPLACE_COMMISSION_PERCENT=8
DELIVERY_FEE_DEFAULT=49
INSTANT_DELIVERY_SURCHARGE=99

# --- observability ----------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
METRICS_ENABLED=true
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- web --------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
